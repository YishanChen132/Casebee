{
  "name": "casebee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @casebee/api & npm run dev --workspace @casebee/web",
    "dev:api": "npm run dev --workspace @casebee/api",
    "dev:web": "npm run dev --workspace @casebee/web",
    "build": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @casebee/api",
    "db:seed": "npm run db:seed --workspace @casebee/api",
    "smoke": "npm run smoke --workspace @casebee/api",
    "accuracy": "npm run accuracy --workspace @casebee/api",
    "accuracy:short": "npm run accuracy 2>&1 | grep '\"overallAccuracy\"'"
  }
}
